<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixture: 04-error-unknown-type/input.xmi
  Propósito: XMI con un atributo de tipo 'MoneyBag', no contemplado en la
             tabla de tipos del §5 del perfil. La conversión debe abortar
             con error UNKNOWN_TYPE.
-->
<xmi:XMI xmi:version="2.1"
         xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20131001">

  <xmi:Documentation exporter="Enterprise Architect" exporterVersion="16.0" exporterID="1558"/>

  <uml:Model xmi:id="MODEL_04" name="Contabilidad" xmi:type="uml:Model">

    <packagedElement xmi:type="uml:Package" xmi:id="PKG_04" name="contabilidad">

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_30" name="Factura" isAbstract="false">
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_30" name="numero" type="String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_30" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_30" value="1"/>
        </ownedAttribute>
        <!-- Tipo no soportado: MoneyBag -->
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_31" name="total" type="MoneyBag">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="LV_31" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_31" value="1"/>
        </ownedAttribute>
      </packagedElement>

    </packagedElement>

  </uml:Model>
</xmi:XMI>
