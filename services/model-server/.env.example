# Configuración de model-server (contrato: src/config.ts — loadConfig).
# Copiar a .env y ajustar. Nunca versionar .env (ya está en .gitignore).

# Obligatorias ------------------------------------------------------------

# Cadena de conexión PostgreSQL (única fuente de verdad de la plataforma).
# Puerto 15432 = postgres del docker-compose (5432 suele estar ocupado por un postgres nativo).
DATABASE_URL=postgres://postgres:postgres@localhost:15432/case

# Secreto para firmar access tokens JWT. Mínimo 32 caracteres.
# Generar uno real con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars

# Orígenes permitidos por CORS (separados por coma). También valida la
# cabecera Origin del handshake WebSocket.
CORS_ORIGINS=http://localhost:5173

# Opcionales --------------------------------------------------------------

# Puerto/host de escucha.
#PORT=3000
#HOST=127.0.0.1

# TTL del access token JWT en segundos (default 900 = 15 min).
#ACCESS_TOKEN_TTL_SECONDS=900

# TTL del refresh token en segundos (default 2592000 = 30 días).
#REFRESH_TOKEN_TTL_SECONDS=2592000

# Cookie refresh con atributo Secure. true requiere HTTPS; para desarrollo
# local sobre http://localhost usar false.
#SECURE_COOKIES=true

# Reconocimiento de diagramas por IA (multimodal-proposals-v1, endpoint
# POST /api/v1/diagrams/:id/proposals). Si AI_PROVIDER no está definido el
# endpoint responde 503 AI_NOT_CONFIGURED.
#
# Proveedor: "gemini" (nube, requiere GEMINI_API_KEY) u "ollama" (local).
#AI_PROVIDER=ollama
#
# Gemini — modelo con visión; por defecto gemini-2.5-flash.
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash
#
# Ollama — servidor local; el modelo debe tener visión (llava, llama3.2-vision).
#OLLAMA_BASE_URL=http://127.0.0.1:11434
#OLLAMA_MODEL=llava
