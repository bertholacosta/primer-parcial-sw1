{{/each}}
{{#each associations}}
    {{{this.annotationFull}}}
    {{#unless this.joinTable}}
    {{#if this.joinColumn}}
    @JoinColumn(name = "{{this.joinColumn}}")
    {{/if}}
    {{/unless}}
    {{#if this.joinTable}}
