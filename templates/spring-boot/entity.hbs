{{/if}}
{{#each attributes}}
    public {{this.javaType}} get{{this.capitalizedName}}() { return {{this.name}}; }
    public void set{{this.capitalizedName}}({{this.javaType}} {{this.name}}) { this.{{this.name}} = {{this.name}}; }
{{/each}}
{{#each associations}}
    public {{this.javaType}} get{{this.capitalizedName}}() { return {{this.name}}; }
